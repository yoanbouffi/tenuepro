{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/c/:id",
      "destination": "https://n8n.landiz.re/webhook/tenuepro-clic?c=:id"
    },
    {
      "source": "/realisations",
      "destination": "/solutions"
    },
    {
      "source": "/(.*)",
      "destination": "/app"
    }
  ]
}
